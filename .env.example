# Google Analytics 4 measurement ID (optional).
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Real-time lightning stack (ROADMAP Phases 2–4) ---

# Redis used by the Python ingest worker and Next.js API routes.
# Local docker-compose: redis://127.0.0.1:6379
# Upstash: rediss://default:PASSWORD@HOST:6379
REDIS_URL=redis://127.0.0.1:6379

# Optional Postgres + PostGIS (history + future alert subscriptions)
DATABASE_URL=postgresql://lightning:lightning@127.0.0.1:5432/lightning

# Public site origin (CORS / canonical)
NEXT_PUBLIC_SITE_ORIGIN=https://lightningtracker.net

# Free GLM worker → Next.js (used when Redis is down, or as dual-write)
INGEST_HTTP_URL=http://127.0.0.1:3000/api/internal/ingest
INGEST_SECRET=dev-ingest-secret
# INGEST_POLL_SECONDS=20

# Synthetic map dots for UI work only (off by default — prefer real GLM)
# ENABLE_DEMO_STRIKES=1

# Map tiles: Esri dark gray (no key). Optional MapTiler override unused by Leaflet path.
# NEXT_PUBLIC_MAPTILER_KEY=

# Web Push (Phase 6 — optional for now)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@lightningtracker.net

# Commercial lightning API (Phase 7 — optional)
# XWEATHER_CLIENT_ID=
# XWEATHER_CLIENT_SECRET=

# Europe / Africa / Middle East lightning (EUMETSAT MTG Lightning Imager) — free key:
# register at https://data.eumetsat.int, then create an API key at https://api.eumetsat.int/api-key
# EUMETSAT_CONSUMER_KEY=
# EUMETSAT_CONSUMER_SECRET=

# --- Vercel / serverless (shared storage) ---
# Create an Upstash Redis database (Vercel dashboard -> Storage -> Marketplace -> Upstash Redis).
# The integration adds KV_REST_API_URL / KV_REST_API_TOKEN automatically; these names also work:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Random string protecting /api/cron/ingest (Vercel Cron sends it as a Bearer token):
# CRON_SECRET=
