{
  "name": "lightning-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:geo": "node --import tsx --test packages/shared/src/geo.test.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "worker:install": "python3 -m pip install -r workers/ingest/requirements.txt",
    "worker": "python3 workers/ingest/main.py"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/credential-provider-node": "^3.972.88",
    "@upstash/redis": "^1.39.0",
    "critters": "^0.0.23",
    "fflate": "^0.8.3",
    "h5wasm": "^0.10.3",
    "ioredis": "^6.0.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.15.0",
    "netcdfjs": "^4.0.0",
    "next": "^16.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.58.1",
    "react-leaflet": "^5.0.0",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.19.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9",
    "eslint-config-next": "^16.3.2",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "browserslist": {
    "production": [
      "chrome >= 90",
      "firefox >= 88",
      "safari >= 14",
      "edge >= 90"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
